<div class="field-unit__label">
  <%= f.label field.attribute, "Workspace Features" %>
</div>
<div class="field-unit__field feature-container w-full">
  <% 
    all_features = SuperAdmin::AccountFeaturesHelper.filtered_features(field.data)
  %>

  <div class="bg-slate-50/70 p-4 rounded-xl border border-slate-200">
    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">
      Enable / Disable Features for this Workspace
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
      <% all_features.each do |key_array, val| %>
        <% feature_key, display_name = key_array %>
        <label class="flex items-center justify-between p-3 bg-white rounded-lg shadow-xs border border-slate-200 hover:border-blue-400 cursor-pointer transition-colors">
          <div class="flex items-center gap-2 mr-2">
            <span class="text-xs font-medium text-slate-800"><%= display_name %></span>
          </div>
          <div>
            <%= check_box "enabled_features", "feature_#{feature_key}", { checked: val, class: "h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" }, true, false %>
          </div>
        </label>
      <% end %>
    </div>
  </div>
</div>
