<div class="w-full">
  <% 
    all_features = SuperAdmin::AccountFeaturesHelper.filtered_features(field.data)
  %>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
    <% all_features.each do |key_array, val| %>
      <% feature_key, display_name = key_array %>
      <div class="flex items-center justify-between p-3 bg-white rounded-lg border <%= val.present? ? 'border-slate-200 shadow-xs' : 'border-slate-100 bg-slate-50/40 opacity-60' %>">
        <span class="text-xs font-medium text-slate-800"><%= display_name %></span>
        <span class="<%= val.present? ? 'bg-emerald-500 text-white': 'bg-slate-200 text-slate-500' %> rounded-full p-1 inline-flex">
          <svg width="10" height="10"><use xlink:href="<%= val.present? ? '#icon-tick-line' : '#icon-lock-line' %>" /></svg>
        </span>
      </div>
    <% end %>
  </div>
</div>
