<% content_for(:title) do %>
  Platform Settings & Features
<% end %>

<header class="flex px-8 py-5 items-center justify-between border-b border-slate-200 bg-white" role="banner">
  <div class="flex items-center">
    <div class="border border-slate-200 mr-4 p-2.5 rounded-xl bg-slate-50 text-slate-700">
      <svg width="22" height="22"><use xlink:href="#icon-settings-2-line" /></svg>
    </div>
    <div class="flex flex-col justify-center">
      <div class="flex items-center gap-2">
        <h1 class="text-lg font-bold leading-6 text-slate-900" id="page-title">
          <%= content_for(:title) %>
        </h1>
        <span class="px-2 py-0.5 rounded text-xs font-semibold bg-blue-50 text-blue-700">Limcx Platform</span>
      </div>
      <p class="text-xs font-normal text-slate-500 m-0">Global environment configuration, AI providers, and workspace feature management.</p>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <a href="<%= super_admin_app_config_url(config: 'general') %>" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold shadow-sm transition-colors">
      <svg width="14" height="14"><use xlink:href="#icon-paint-brush-line" /></svg>
      <span>Branding & General</span>
    </a>
  </div>
</header>

<section class="main-content__body px-8 py-6 space-y-8 bg-slate-50/50 min-h-screen">
  <!-- Top Info Card: Installation Identifier & Platform Edition -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Identifier -->
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Installation Identifier</span>
        <div class="mt-2 flex items-center gap-2">
          <%= javascript_include_tag "secretField" %>
          <div data-secret-text="<%= ChatwootHub.installation_identifier %>" class="cell-data__secret-field text-xs font-mono text-slate-700 bg-slate-50 px-3 py-1.5 rounded-lg border border-slate-200 flex items-center gap-2">
            <span data-secret-masked="true" class="select-none">••••••••••••••••••••••••••••••••</span>
            <button type="button" onclick="toggleSecretField(event)" data-secret-toggler class="inline-flex items-center justify-center p-1 rounded text-slate-500 hover:text-slate-800 transition-colors focus:outline-none" title="Show/Hide">
              <svg width="16" height="16" class="fill-current">
                <use xlink:href="#eye-show" />
              </svg>
            </button>
            <button type="button" onclick="copySecretField(event)" data-secret-copier class="inline-flex items-center justify-center p-1 rounded text-slate-500 hover:text-slate-800 transition-colors focus:outline-none" title="Copy to clipboard">
              <svg width="16" height="16" class="fill-current">
                <use xlink:href="#icon-copy" />
              </svg>
            </button>
          </div>
        </div>
      </div>
      <div class="text-xxs text-slate-400 mt-3">Unique node identifier for telemetry and instance diagnostics.</div>
    </div>

    <!-- Edition & Build -->
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Platform Build</span>
        <div class="mt-2 flex items-center gap-2">
          <span class="text-sm font-bold text-slate-900">Limcx Unified v<%= Chatwoot.config[:version] %></span>
          <span class="px-2 py-0.5 rounded text-xxs font-mono bg-slate-100 text-slate-600">SHA: <%= GIT_HASH.to_s[0..7] %></span>
        </div>
      </div>
      <div class="text-xxs text-slate-500 mt-3 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Independent self-hosted platform engine</span>
      </div>
    </div>
  </div>

  <!-- Quick Configuration Category Tabs -->
  <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm space-y-4">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">
        Platform Config Providers
      </h2>
      <span class="text-xs text-slate-400">Select a section to manage API credentials & settings</span>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
      <% 
        config_shortcuts = [
          { key: 'general', name: 'General & Brand', icon: 'icon-paint-brush-line', color: 'text-blue-600 bg-blue-50' },
          { key: 'captain', name: 'AI & LLM Engine', icon: 'icon-captain', color: 'text-violet-600 bg-violet-50' },
          { key: 'email', name: 'Email & SMTP', icon: 'icon-mail-send-fill', color: 'text-emerald-600 bg-emerald-50' },
          { key: 'google', name: 'Google OAuth', icon: 'icon-google', color: 'text-amber-600 bg-amber-50' },
          { key: 'microsoft', name: 'Microsoft 365', icon: 'icon-microsoft', color: 'text-sky-600 bg-sky-50' },
          { key: 'facebook', name: 'Facebook & IG', icon: 'icon-messenger-line', color: 'text-blue-600 bg-blue-50' },
          { key: 'whatsapp_embedded', name: 'WhatsApp Cloud', icon: 'icon-whatsapp-line', color: 'text-emerald-600 bg-emerald-50' },
          { key: 'tiktok', name: 'TikTok Direct', icon: 'icon-tiktok', color: 'text-slate-800 bg-slate-100' },
          { key: 'slack', name: 'Slack Sync', icon: 'icon-slack', color: 'text-rose-600 bg-rose-50' },
          { key: 'linear', name: 'Linear Issues', icon: 'icon-linear', color: 'text-indigo-600 bg-indigo-50' },
          { key: 'notion', name: 'Notion Database', icon: 'icon-notion', color: 'text-slate-700 bg-slate-100' },
          { key: 'shopify', name: 'Shopify Store', icon: 'icon-shopify', color: 'text-emerald-700 bg-emerald-50' },
        ]
      %>

      <% config_shortcuts.each do |c| %>
        <%= link_to super_admin_app_config_url(config: c[:key]), class: "flex flex-col items-center text-center p-3 rounded-xl border border-slate-200 hover:border-blue-400 hover:shadow-xs transition-all group bg-white" do %>
          <div class="w-9 h-9 rounded-lg flex items-center justify-center <%= c[:color] %> mb-2 group-hover:scale-105 transition-transform">
            <svg width="18" height="18"><use xlink:href="#<%= c[:icon] %>" /></svg>
          </div>
          <span class="text-xs font-semibold text-slate-800 group-hover:text-blue-600 truncate w-full"><%= c[:name] %></span>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Features Grid -->
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-base font-bold text-slate-900 tracking-tight">Platform Features & Workspace Control</h2>
        <p class="text-xs text-slate-500">All features below are natively active on your Limcx instance and can be enabled per workspace under Workspaces &rarr; Edit.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% SuperAdmin::FeaturesHelper.available_features.each do |feature, attrs| %>
        <div class="bg-white border border-slate-200 p-5 rounded-xl shadow-sm flex flex-col justify-between hover:border-slate-300 transition-colors">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="w-9 h-9 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center border border-blue-100">
                <svg width="18" height="18"><use xlink:href="#<%= attrs[:icon] %>" /></svg>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="px-2 py-0.5 rounded text-xxs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60 flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                  Active
                </span>
              </div>
            </div>

            <h3 class="text-sm font-bold text-slate-900 mb-1"><%= attrs[:name] %></h3>
            <p class="text-xs text-slate-500 leading-relaxed"><%= attrs[:description] %></p>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xxs font-medium text-slate-400 uppercase tracking-wider">
              <%= attrs[:category] || 'Module' %>
            </span>

            <% if attrs[:config_key].present? %>
              <%= link_to super_admin_app_config_url(config: attrs[:config_key]), class: "inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-700" do %>
                <span>Configure</span>
                <svg width="12" height="12"><use xlink:href="#icon-arrow-right" /></svg>
              <% end %>
            <% else %>
              <span class="text-xxs text-slate-400 font-medium">Built-in</span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
