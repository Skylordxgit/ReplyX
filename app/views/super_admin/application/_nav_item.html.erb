<%#
# Navigation Item Partial
%>

<li class="mb-0.5">
  <% is_active = current_page?(url) %>
  <% link_classes = is_active ? 'bg-blue-50 text-blue-700 font-semibold' : 'text-slate-700 hover:bg-slate-100 hover:text-slate-900 font-medium' %>
  <%= link_to(url, class: "#{link_classes} focus:outline-none flex items-center px-3 py-2 text-xs rounded-lg transition-colors group") do %>
    <svg width="16" height="16" class="<%= is_active ? 'text-blue-600' : 'text-slate-400 group-hover:text-slate-600' %> flex-shrink-0 transition-colors">
      <use xlink:href="#<%= icon %>" />
    </svg>
    <span class="ml-2.5 truncate"><%= label %></span>
  <% end %>
</li>
