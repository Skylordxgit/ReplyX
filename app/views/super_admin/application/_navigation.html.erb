<%#
# Limcx Super Admin Navigation
%>

<%= vite_client_tag %>
<%= vite_javascript_tag 'superadmin_pages' %>

<%
  sidebar_icons = {
    accounts: 'icon-building-4-line',
    users: 'icon-user-follow-line',
    platform_apps: 'icon-apps-2-line',
    agent_bots: 'icon-robot-line',
    platform_banners: 'icon-megaphone-line',
  }
%>

<div class="border-slate-200 border-r w-60 flex-shrink-0 justify-between h-full flex flex-col bg-white select-none" role="navigation">
  <div class="overflow-y-auto flex-1 py-4">
    <!-- Limcx Brand Header -->
    <div class="flex items-center mx-4 pb-5 border-slate-100 border-b">
      <%= link_to image_tag('/brand-assets/logo_thumbnail.svg', alt: 'Limcx Super Admin', class: 'h-9 w-9 rounded-lg shadow-xs'), super_admin_root_url %>
      <div class="flex flex-col ml-3 min-w-0">
        <div class="text-sm font-bold text-slate-900 tracking-tight flex items-center gap-1.5">
          <span>Limcx</span>
          <span class="px-1.5 py-0.2 rounded text-xxs font-semibold bg-blue-50 text-blue-700">Admin</span>
        </div>
        <div class="text-xxs text-slate-500 truncate">Platform Console</div>
      </div>
    </div>

    <!-- Main Navigation Menu -->
    <div class="px-3 pt-4">
      <div class="text-xxs font-semibold uppercase tracking-wider text-slate-400 px-3 mb-2">
        Platform Core
      </div>
      <ul class="space-y-0.5 mb-5">
        <%= render partial: "nav_item", locals: { icon: 'icon-grid-line', url: super_admin_root_url, label: 'Dashboard' } %>
        <%= render partial: "nav_item", locals: { icon: 'icon-building-4-line', url: super_admin_accounts_url, label: 'Workspaces' } %>
        <%= render partial: "nav_item", locals: { icon: 'icon-user-follow-line', url: super_admin_users_url, label: 'Users & Agents' } %>
        <%= render partial: "nav_item", locals: { icon: 'icon-apps-2-line', url: super_admin_platform_apps_url, label: 'Platform Apps' } %>
        <%= render partial: "nav_item", locals: { icon: 'icon-robot-line', url: super_admin_agent_bots_url, label: 'Agent Bots' } %>
      </ul>

      <div class="text-xxs font-semibold uppercase tracking-wider text-slate-400 px-3 mb-2">
        Configuration
      </div>
      <ul class="space-y-0.5 mb-5">
        <%= render 'settings_menu', open: settings_open? %>
      </ul>

      <div class="text-xxs font-semibold uppercase tracking-wider text-slate-400 px-3 mb-2">
        System & Ops
      </div>
      <ul class="space-y-0.5">
        <%= render partial: "nav_item", locals: { icon: 'icon-health-book-line', url: super_admin_instance_status_url, label: 'System Health' } %>
        <%= render partial: "nav_item", locals: { icon: 'icon-mist-fill', url: sidekiq_web_url, label: 'Sidekiq Monitor' } %>
        <%= render partial: "nav_item", locals: { icon: 'icon-mail-send-fill', url: super_admin_push_diagnostics_url, label: 'Push Diagnostics' } %>
      </ul>
    </div>
  </div>

  <!-- Bottom Navigation Actions -->
  <div class="p-3 border-t border-slate-100 bg-slate-50/70">
    <ul class="space-y-1">
      <%= render partial: "nav_item", locals: { icon: 'icon-dashboard-line', url: '/', label: 'Agent Workspace' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-logout-circle-r-line', url: super_admin_logout_url, label: 'Sign Out' } %>
    </ul>
  </div>
</div>
