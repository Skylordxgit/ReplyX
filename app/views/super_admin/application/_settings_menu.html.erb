<%#
# Settings Menu Partial
%>

<li class="mb-0.5">
  <details class="group" <%= 'open' if open %>>
    <summary class="flex items-center px-3 py-2 cursor-pointer rounded-lg text-xs font-medium <%= open ? 'bg-slate-100 text-slate-900 font-semibold' : 'text-slate-700 hover:bg-slate-100 hover:text-slate-900' %> list-none transition-colors select-none">
      <%= link_to super_admin_settings_url, class: 'flex items-center flex-1' do %>
        <svg width="16" height="16" class="text-slate-400 group-hover:text-slate-600 flex-shrink-0"><use xlink:href="#icon-settings-2-line" /></svg>
        <span class="ml-2.5 truncate">Platform Settings</span>
      <% end %>
      <svg class="ml-auto w-3.5 h-3.5 text-slate-400 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </summary>
    <ul class="pl-5 pr-1 mt-1 space-y-0.5 border-l-2 border-slate-100 ml-4">
      <% settings_pages.each do |_feature_key, attrs| %>
        <% url = super_admin_app_config_url(config: attrs['config_key']) %>
        <li>
          <% is_page_active = current_page?(url) %>
          <% sub_classes = is_page_active ? 'text-blue-600 font-semibold bg-blue-50/60' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50' %>
          <%= link_to url, class: "#{sub_classes} flex items-center px-2.5 py-1.5 text-xxs rounded-md transition-colors" do %>
            <span class="truncate"><%= attrs['name'] %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </details>
</li>
