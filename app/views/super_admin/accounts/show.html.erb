<%#
# Limcx Workspace Show View
%>

<% content_for(:title) do %>
  <%= page.page_title %>
<% end %>

<header class="flex px-8 py-5 items-center justify-between border-b border-slate-200 bg-white" role="banner">
  <div class="flex items-center">
    <div class="border border-slate-200 mr-4 p-2.5 rounded-xl bg-slate-50 text-slate-700">
      <svg width="22" height="22"><use xlink:href="#icon-building-4-line" /></svg>
    </div>
    <div class="flex flex-col justify-center">
      <div class="flex items-center gap-2">
        <h1 class="text-lg font-bold leading-6 text-slate-900" id="page-title">
          <%= page.page_title %>
        </h1>
        <% if page.resource.status == 'active' %>
          <span class="px-2 py-0.5 rounded text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60 flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Active
          </span>
        <% else %>
          <span class="px-2 py-0.5 rounded text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200/60 flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
            <%= page.resource.status.to_s.titleize %>
          </span>
        <% end %>
      </div>
      <p class="text-xs font-normal text-slate-500 m-0">Workspace ID #<%= page.resource.id %> • Created <%= page.resource.created_at.strftime("%b %d, %Y") %></p>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <a href="/app/accounts/<%= page.resource.id %>/dashboard" target="_blank" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold shadow-sm transition-colors">
      <svg width="14" height="14"><use xlink:href="#icon-dashboard-line" /></svg>
      <span>Open Workspace &rarr;</span>
    </a>
    <%= if accessible_action?(page.resource, :edit)
      link_to([:edit, namespace, page.resource], class: "inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 text-xs font-semibold shadow-sm transition-colors") do %>
        <svg width="14" height="14"><use xlink:href="#icon-edit-line" /></svg>
        <span>Edit Settings</span>
      <% end
    end %>
  </div>
</header>

<section class="main-content__body px-8 py-6 space-y-6 bg-slate-50/50 min-h-screen">
  <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
    <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-4 pb-2 border-b border-slate-100">
      Workspace Details & Limits
    </h2>

    <div class="pr-0 space-y-4">
      <% page.attributes.each do |title, attributes| %>
        <% if title.present? && title == 'all_features' %>
          <div class="mt-6 pt-4 border-t border-slate-100">
            <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">Enabled Features</h3>
            <div class="space-y-4">
              <% attributes.each do |attribute| %>
                <div class="attribute-data attribute-data--<%=attribute.html_class%>"><%= render_field attribute, page: page %></div>
              <% end %>
            </div>
          </div>
        <% else %>
          <fieldset class="<%= "field-unit--nested" if title.present? %>">
            <% if title.present? %>
              <legend class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3"><%= t "helpers.label.#{page.resource_name}.#{title}", default: title %></legend>
            <% end %>

            <% attributes.each do |attribute| %>
              <div class="grid grid-cols-1 md:grid-cols-4 py-2 border-b border-slate-50 items-center">
                <div class="text-xs font-medium text-slate-500" id="<%= attribute.name %>">
                  <%= t(
                    "helpers.label.#{resource_name}.#{attribute.name}",
                    default: page.resource.class.human_attribute_name(attribute.name),
                  ) %>
                </div>

                <div class="md:col-span-3 text-xs font-semibold text-slate-900 attribute-data attribute-data--<%=attribute.html_class%>">
                  <%= render_field attribute, page: page %>
                </div>
              </div>
            <% end %>
          </fieldset>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
    <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-4 pb-2 border-b border-slate-100">
      Workspace Users & Memberships
    </h2>
    <%= render 'super_admin/shared/account_user_form', page: page, namespace: namespace, resource_type: 'account' %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
      <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-2">
        Sample Test Fixtures
      </h2>
      <p class="text-xs text-slate-500 mb-4">Populate this workspace with demo inboxes, conversations, and contacts for testing.</p>
      <%= render partial: "seed_data", locals: { page: page } %>
    </div>

    <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
      <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-2">
        Workspace Cache Reset
      </h2>
      <p class="text-xs text-slate-500 mb-4">Purge all Redis cache keys associated with this workspace to force fresh loads.</p>
      <%= render partial: "reset_cache", locals: { page: page } %>
    </div>
  </div>
</section>
