<% content_for(:title) do %>
  Configure <%= @config.titleize %> Settings
<% end %>

<header class="flex px-8 py-5 items-center justify-between border-b border-slate-200 bg-white" role="banner">
  <div class="flex items-center">
    <div class="border border-slate-200 mr-4 p-2.5 rounded-xl bg-slate-50 text-slate-700">
      <svg width="22" height="22"><use xlink:href="#icon-settings-2-line" /></svg>
    </div>
    <div class="flex flex-col justify-center">
      <div class="flex items-center gap-2">
        <h1 class="text-lg font-bold leading-6 text-slate-900" id="page-title">
          <%= @config.titleize %> Settings
        </h1>
        <span class="px-2 py-0.5 rounded text-xs font-semibold bg-blue-50 text-blue-700">Platform Config</span>
      </div>
      <p class="text-xs font-normal text-slate-500 m-0">Update environment variables and integration credentials for this module.</p>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <a href="<%= super_admin_settings_url %>" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 text-xs font-semibold shadow-sm transition-colors">
      <span>&larr; Back to Settings</span>
    </a>
  </div>
</header>

<section class="main-content__body px-8 py-6 max-w-4xl bg-slate-50/50 min-h-screen">
  <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
    <%= form_with url: super_admin_app_config_url(config: @config), method: :post, html: { class: "space-y-6" } do |form| %>
      <% @allowed_configs.each do |key| %>
        <div class="space-y-1.5 pb-4 border-b border-slate-100 last:border-0 last:pb-0">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-bold text-slate-900 uppercase tracking-wider">
              <%= @installation_configs[key]&.dig('display_title') || key.titleize %>
            </label>
            <span class="text-xxs font-mono text-slate-400"><%= key %></span>
          </div>

          <div>
            <% if @installation_configs[key]&.dig('type') == 'boolean' %>
              <%= form.select "app_config[#{key}]",
                [["Enabled (True)", true], ["Disabled (False)", false]],
                { selected: ActiveModel::Type::Boolean.new.cast(@app_config[key]) },
                class: "block w-full sm:w-64 rounded-lg border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none bg-white"
              %>
            <% elsif @installation_configs[key]&.dig('type') == 'code' %>
              <%= form.text_area "app_config[#{key}]",
                  value: @app_config[key],
                  rows: 8,
                  wrap: 'off',
                  class: "block w-full font-mono text-xs border border-slate-300 rounded-lg p-3 text-slate-900 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none bg-slate-50"
              %>
            <% elsif @installation_configs[key]&.dig('type') == 'secret' || key.include?('SECRET') || key.include?('KEY') || key.include?('PASSWORD') || key.include?('TOKEN') %>
              <div class="relative">
                <%= form.password_field "app_config[#{key}]",
                    id: "app_config_#{key}",
                    value: @app_config[key],
                    placeholder: "••••••••••••••••",
                    class: "block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 pr-10 text-xs text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none font-mono"
                %>
                <button
                  type="button"
                  class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-700 toggle-password"
                  data-target="app_config_<%= key %>"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                </button>
              </div>
            <% elsif @installation_configs[key]&.dig('type') == 'select' && @installation_configs[key]&.dig('options').present? %>
              <%= form.select "app_config[#{key}]",
                @installation_configs[key]['options'].map { |val, label| [label, val] },
                { selected: @app_config[key] },
                class: "block w-full sm:w-80 rounded-lg border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none bg-white"
              %>
            <% else %>
              <%= form.text_field "app_config[#{key}]", value: @app_config[key], placeholder: "Enter #{key.downcase}", class: "block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-xs text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
            <% end %>
          </div>

          <% if @installation_configs[key]&.dig('description').present? %>
            <p class="text-xxs text-slate-500">
              <%= @installation_configs[key]&.dig('description') %>
            </p>
          <% end %>
        </div>
      <% end %>

      <div class="pt-4 flex items-center justify-end gap-3 border-t border-slate-100">
        <a href="<%= super_admin_settings_url %>" class="px-4 py-2 rounded-lg border border-slate-300 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
          Cancel
        </a>
        <button type="submit" class="px-5 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-xs font-bold text-white shadow-sm transition-colors cursor-pointer">
          Save Configuration Changes
        </button>
      </div>
    <% end %>
  </div>
</section>

<% content_for :javascript do %>
  <script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.toggle-password').forEach(button => {
      button.addEventListener('click', () => {
        const targetId = button.dataset.target;
        const input = document.getElementById(targetId);
        if (input) {
          input.type = input.type === 'password' ? 'text' : 'password';
        }
      });
    });
  });
  </script>
<% end %>
