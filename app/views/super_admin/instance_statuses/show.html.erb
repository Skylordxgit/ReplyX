<% content_for(:title) do %>
  System Telemetry & Health
<% end %>

<header class="flex px-8 py-5 items-center justify-between border-b border-slate-200 bg-white" role="banner">
  <div class="flex items-center">
    <div class="border border-slate-200 mr-4 p-2.5 rounded-xl bg-slate-50 text-slate-700">
      <svg width="22" height="22"><use xlink:href="#icon-health-book-line" /></svg>
    </div>
    <div class="flex flex-col justify-center">
      <div class="flex items-center gap-2">
        <h1 class="text-lg font-bold leading-6 text-slate-900" id="page-title">
          <%= content_for(:title) %>
        </h1>
        <span class="px-2 py-0.5 rounded text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          Live Health Monitoring
        </span>
      </div>
      <p class="text-xs font-normal text-slate-500 m-0">Diagnostics for PostgreSQL, Redis, Sidekiq workers, ActiveStorage, and channels.</p>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <a href="/monitoring/sidekiq" target="_blank" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold shadow-sm transition-colors">
      <svg width="14" height="14"><use xlink:href="#icon-mist-fill" /></svg>
      <span>Sidekiq UI &rarr;</span>
    </a>
  </div>
</header>

<section class="main-content__body px-8 py-6 space-y-6 bg-slate-50/50 min-h-screen">
  <!-- Top Core Infrastructure Summary Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- PostgreSQL Status -->
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">PostgreSQL</span>
        <span class="w-2.5 h-2.5 rounded-full <%= @metrics['Postgres alive'] == 'true' ? 'bg-emerald-500' : 'bg-rose-500' %>"></span>
      </div>
      <div class="mt-3">
        <div class="text-lg font-bold text-slate-900"><%= @metrics['Postgres alive'] == 'true' ? 'Connected' : 'Unavailable' %></div>
        <div class="text-xs text-slate-500 mt-1">
          Pool in use: <%= @metrics['DB connections in use'] || 0 %> / <%= @metrics['DB pool size'] || 5 %>
        </div>
      </div>
      <div class="text-xxs text-slate-400 mt-2 font-mono">
        Migrations: <%= @metrics['Database Migrations'] || 'completed' %>
      </div>
    </div>

    <!-- Redis Status -->
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Redis Broker</span>
        <span class="w-2.5 h-2.5 rounded-full <%= @metrics['Redis alive'] == 'true' ? 'bg-emerald-500' : 'bg-rose-500' %>"></span>
      </div>
      <div class="mt-3">
        <div class="text-lg font-bold text-slate-900"><%= @metrics['Redis alive'] == 'true' ? 'Online' : 'Offline' %></div>
        <div class="text-xs text-slate-500 mt-1">
          Memory: <%= @metrics['Redis memory used'] || 'N/A' %> (peak <%= @metrics['Redis memory peak'] || 'N/A' %>)
        </div>
      </div>
      <div class="text-xxs text-slate-400 mt-2 font-mono">
        Clients: <%= @metrics['Redis number of connected clients'] || 0 %> connected
      </div>
    </div>

    <!-- Sidekiq Worker Status -->
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Background Jobs</span>
        <span class="w-2.5 h-2.5 rounded-full <%= (@metrics['Worker failed jobs'].to_i > 0) ? 'bg-amber-500' : 'bg-emerald-500' %>"></span>
      </div>
      <div class="mt-3">
        <div class="text-lg font-bold text-slate-900"><%= @metrics['Worker processed jobs'] || '0' %> Processed</div>
        <div class="text-xs text-slate-500 mt-1">
          Enqueued: <%= @metrics['Worker enqueued jobs'] || 0 %> • Failed: <%= @metrics['Worker failed jobs'] || 0 %>
        </div>
      </div>
      <div class="text-xxs text-slate-400 mt-2 font-mono">
        Processes: <%= @metrics['Worker processes'] || 1 %> active
      </div>
    </div>

    <!-- ActiveStorage Status -->
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">File Storage</span>
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
      </div>
      <div class="mt-3">
        <div class="text-lg font-bold text-slate-900"><%= @metrics['Storage total size'] || '0 B' %></div>
        <div class="text-xs text-slate-500 mt-1">
          Files: <%= @metrics['Storage files count'] || 0 %> blobs
        </div>
      </div>
      <div class="text-xxs text-slate-400 mt-2 font-mono">
        Provider: <%= @metrics['Storage service'] || 'Local' %>
      </div>
    </div>
  </div>

  <!-- Detailed Metric Tables -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Workspaces & Aggregations -->
    <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm space-y-3">
      <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider pb-2 border-b border-slate-100 flex items-center justify-between">
        <span>Workspace & Activity Telemetry</span>
        <span class="text-xxs text-slate-400 normal-case font-mono">Global DB totals</span>
      </h2>

      <div class="divide-y divide-slate-100 text-xs">
        <% 
          workspace_keys = [
            'Total workspaces', 'Active workspaces', 'Suspended workspaces',
            'Total users', 'Active users (last 30 days)', 'Online agents',
            'Total inboxes', 'Total conversations', 'Inboxes requiring reauthorization'
          ]
        %>
        <% workspace_keys.each do |k| %>
          <% if @metrics.key?(k) %>
            <div class="flex items-center justify-between py-2.5">
              <span class="text-slate-600 font-medium"><%= k %></span>
              <span class="font-bold text-slate-900 font-mono <%= (k == 'Inboxes requiring reauthorization' && @metrics[k].to_i > 0) ? 'text-rose-600' : '' %>">
                <%= @metrics[k] %>
              </span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Infrastructure & Environment -->
    <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm space-y-3">
      <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider pb-2 border-b border-slate-100 flex items-center justify-between">
        <span>Environment & System Runtimes</span>
        <span class="text-xxs text-slate-400 normal-case font-mono">Server build</span>
      </h2>

      <div class="divide-y divide-slate-100 text-xs">
        <% 
          env_keys = [
            'Platform edition', 'Limcx version', 'Git SHA',
            'Environment', 'Ruby version', 'Rails version',
            'Database Migrations', 'DB pool size', 'DB total connections',
            'Redis version', "Redis 'maxmemory' setting", "Redis 'maxmemory_policy' setting"
          ]
        %>
        <% env_keys.each do |k| %>
          <% if @metrics.key?(k) %>
            <div class="flex items-center justify-between py-2.5">
              <span class="text-slate-600 font-medium"><%= k %></span>
              <span class="font-semibold text-slate-900 font-mono text-xs">
                <%= @metrics[k] %>
              </span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Full Diagnostics Raw Key-Value Section -->
  <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
    <details class="group">
      <summary class="text-xs font-semibold text-slate-600 cursor-pointer flex items-center justify-between uppercase tracking-wider">
        <span>Complete Diagnostic Metrics (<%= @metrics.size %> fields)</span>
        <span class="text-blue-600 normal-case group-open:hidden">Show Raw &darr;</span>
        <span class="text-blue-600 normal-case hidden group-open:inline">Hide Raw &uarr;</span>
      </summary>

      <div class="mt-4 border-t border-slate-100 pt-3">
        <table class="w-full text-xs text-left">
          <thead>
            <tr class="border-b border-slate-100 text-slate-400 uppercase text-xxs">
              <th class="py-2">Metric Key</th>
              <th class="py-2">Runtime Value</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 font-mono">
            <% @metrics.each do |key, value| %>
              <tr class="hover:bg-slate-50">
                <td class="py-2 text-slate-700"><%= key %></td>
                <td class="py-2 font-semibold text-slate-900"><%= value %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </details>
  </div>
</section>
