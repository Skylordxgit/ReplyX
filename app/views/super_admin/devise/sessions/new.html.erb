<!DOCTYPE html>
<html>
  <head>
    <title>Super Admin | Limcx</title>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'superadmin' %>
    <%= csrf_meta_tags %>
  </head>
  <body class="bg-slate-50 antialiased">
    <div class="min-h-screen flex flex-col justify-center py-12 sm:px-6 lg:px-8">
      <div class="sm:mx-auto sm:w-full sm:max-w-md text-center">
        <img src="/brand-assets/logo_thumbnail.svg" alt="Limcx" class="mx-auto h-12 w-auto mb-3">
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">
          Limcx Super Admin
        </h2>
        <p class="mt-1 text-xs text-slate-500">
          Sign in to the platform management & infrastructure console
        </p>
      </div>

      <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="bg-white py-8 px-6 shadow-sm border border-slate-200 rounded-xl sm:px-10">
          <%= form_for(resource, as: resource_name, url: '/super_admin/sign_in', html: { class: "space-y-5" }) do |f| %>
            <% if flash[:error].present? %>
              <div data-alert class="rounded-lg bg-rose-50 border border-rose-200 p-3 text-rose-700 text-xs font-medium"><%= flash[:error] %></div>
            <% end %>

            <div>
              <label for="email_address" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                Admin Email
              </label>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "admin@limcx.com", class: "block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-xs text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-colors" %>
            </div>

            <div>
              <label for="password" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                Password
              </label>
              <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••••••", class: "block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-xs text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-colors" %>
            </div>

            <button type="submit" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer transition-colors">
              Sign In to Platform Console &rarr;
            </button>
          <% end %>

          <div class="mt-6 pt-5 border-t border-slate-100 text-center">
            <a href="/" class="text-xs font-medium text-slate-500 hover:text-slate-800 transition-colors">
              &larr; Return to Agent Workspace
            </a>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
