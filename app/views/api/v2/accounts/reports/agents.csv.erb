<%= CSVSafe.generate_line [I18n.t('reports.period', since: Date.strptime(params[:since], '%s'), until: Date.strptime(params[:until], '%s'))] %>

<% count_headers = Api::V2::Accounts::ReportsHelper::AGENT_COUNT_KEYS.map do |key|
     I18n.t("reports.agent_csv.#{key}")
   end
%>
<% headers = [I18n.t('reports.agent_csv.agent_name')] + count_headers + Reports::AgentTimingCsvPresenter.headers + [I18n.t('reports.agent_csv.csat')] %>
<%= CSVSafe.generate_line headers -%>
<% @report_data.each do |row| %>
<%= CSVSafe.generate_line row -%>
<% end %>
